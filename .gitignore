# Laid by Claude Code on every load; regenerate, don't commit.
plugins/*/.claude-plugin/types/
.DS_Store

# Per-session cache written by the impeccable hook.
.impeccable/

# Private working notes and an outdated internal deck, kept out of the public repo.
docs/*.pptx
docs/handoff.md
docs/research/

# An early terminal mockup, replaced by the design files in docs/panel/design.
docs/panel/*.png
docs/panel/build_mock.py

# Throwaway experiment mods and their results (they hold local paths and usage counts).
experiments/
docs/experiments.md

# This project's own Clawd HQ logbook (private decisions); other projects commit theirs.
.clawd-hq/

# Skills installed into this folder by `npx skills add` (local only).
.agents/
